#!/usr/bin/env python3

from concurrent.futures import ThreadPoolExecutor
import glob
import json
import os
import re
import subprocess
import sys
from threading import Lock

outputMutex = Lock()

# Exclude config files that are not verifying from CI
EXCLUDE_CONFS = []

# Harnesses import whole src modules and specs import each other, so a change to
# any of these can affect confs that don't list the changed file.
SHARED_PATHS = (
    'src/',
    'lib/',
    'certora/harness/',
    'certora/helpers/',
    'certora/specs/',
    '.github/workflows/checkrules.yml',
    '.github/executables/checkAllSpecs',
)

HEALTH_STATUS_RULE = 'accountsStayHealthy_strategy'

# Same split as certora/scripts/runHealthStatusAllModules.py: these modules are
# too slow to verify as a whole, so they run once per method or per rule.
SPLIT_BY_METHOD = {
    'certora/conf/healthStatus/GovernanceHealthStatus.conf': [
        'convertFees()',
        'setGovernorAdmin(address)',
        'setFeeReceiver(address)',
        'setMaxLiquidationDiscount(uint16)',
        'setLiquidationCoolOffTime(uint16)',
        'setInterestRateModel(address)',
        'setHookConfig(address,uint32)',
        'setConfigFlags(uint32)',
        'setCaps(uint16,uint16)',
        'setInterestFee(uint16)',
    ],
    'certora/conf/healthStatus/TokenHealthStatus.conf': [
        'transfer(address,uint256)',
        'transferFromMax(address,address)',
        'transferFrom(address,address,uint256)',
        'approve(address,uint256)',
    ],
    'certora/conf/healthStatus/BorrowingHealthStatus.conf': [
        'borrow(uint256,address)',
        'pullDebt(uint256,address)',
        'repayWithShares(uint256,address)',
        'repay(uint256,address)',
    ],
    'certora/conf/healthStatus/VaultHealthStatus.conf': [
        'deposit(uint256,address)',
        'mint(uint256,address)',
        'withdraw(uint256,address,address)',
        'redeem(uint256,address,address)',
        'skim(uint256,address)',
    ],
}
SPLIT_BY_RULE = {
    'certora/conf/healthStatus/LiquidateHealthStatus.conf': [
        'liquidateAccountsStayHealthy_liquidator_no_debt_socialization',
        'liquidateAccountsStayHealthy_liquidator_with_debt_socialization',
        'liquidateAccountsStayHealthy_not_violator',
        'liquidateAccountsStayHealthy_account_cur_contract',
    ],
}

def listConfigs() -> list[str]:
    """List all config files."""
    subdir_confs = glob.glob('certora/conf/**/*.conf', recursive=True)
    root_confs = glob.glob('certora/conf/*.conf', recursive=True)
    confs = sorted(set(subdir_confs + root_confs))
    return [x for x in confs if x not in EXCLUDE_CONFS]

def loadConf(filename: str) -> dict:
    """Load a conf file, which may contain comments and trailing commas."""
    text = open(filename).read()
    text = re.sub(r'(^|\s)//[^\n]*', r'\1', text)
    text = re.sub(r',(\s*[\]}])', r'\1', text)
    return json.loads(text)

def loadConfigDependencies(filename: str) -> set[str]:
    """Load all files a config depends on."""
    try:
        conf = loadConf(filename)
        spec = re.findall(r'certora/specs/.+\.spec', conf['verify'])
        return set([filename, *spec, *conf['files']])
    except Exception:
        print(f'invalid json in {filename}!')
        return set()

def listChangedConfigs() -> list[str]:
    """List config files that the PR changes. Outside a PR, when a shared input
    changed, or when the diff fails, list all config files."""
    # The base commit from the triggering event, not the base branch's tip: a run
    # approved after the merge must still see the PR's changes.
    BASESHA = os.environ.get('BASE_SHA', '')
    if BASESHA == '':
        return listConfigs()
    print('::group::Identifying changed configurations', flush=True)
    fetch = subprocess.run(['git', 'fetch', '--depth=1', 'origin', BASESHA])
    diff = subprocess.run(['git', '-P', 'diff', '--name-only', BASESHA, 'HEAD'], capture_output=True)
    if fetch.returncode != 0 or diff.returncode != 0:
        print('could not diff against the base commit, running all configs')
        print('::endgroup::')
        return listConfigs()
    changed = set(diff.stdout.decode().splitlines())
    shared = sorted(c for c in changed if c.startswith(SHARED_PATHS))
    if shared:
        print(f'shared inputs changed, running all configs: {shared}')
        print('::endgroup::')
        return listConfigs()
    cfiles = { c: loadConfigDependencies(c) for c in listConfigs() }
    changedConfs = [ c for c in cfiles if (not cfiles[c]) or (cfiles[c] & changed)]
    print(f'changed configs: {changedConfs}')
    print('::endgroup::')
    return changedConfs

def jobsFor(filename: str) -> list[tuple[str, list[str]]]:
    """The prover runs for one config, as (filename, extra certoraRun args)."""
    if filename in SPLIT_BY_METHOD:
        return [(filename, ['--rule', HEALTH_STATUS_RULE, '--method', m]) for m in SPLIT_BY_METHOD[filename]]
    if filename in SPLIT_BY_RULE:
        return [(filename, ['--rule', r]) for r in SPLIT_BY_RULE[filename]]
    if filename.startswith('certora/conf/healthStatus/'):
        return [(filename, ['--rule', HEALTH_STATUS_RULE])]
    return [(filename, [])]

def runConf(job):
    """Run one prover job and return None if everything worked, or the
    CompletedProcess when there was some error."""
    filename, extra = job
    label = ' '.join([filename, *extra])
    print(f'Starting {label}')
    try:
        res = subprocess.run(['certoraRun', '--server', 'production', '--wait_for_results', 'all', filename, *extra],
                             capture_output = True)
    except Exception as e:
        with outputMutex:
            print(f'Failed to run {label}: {e}')
        return None

    setattr(res, 'label', label)
    with outputMutex:
        out = res.stdout.decode().strip()
        m = re.search(r'https://[a-z-]+\.certora\.com/output/[0-9a-zA-Z?=/]+', out)
        if m:
            runurl = m.group(0)
        else:
            runurl = 'run not available'
        print(f'::group::Results for {label} ({runurl})')
        if res.stdout != b'':
            print(out)
        if res.stderr != b'':
            print(f'error output:')
            print(res.stderr.decode().strip())
        if res.returncode != 0:
            print(f'Failed with {res.returncode}')
            print(f'::endgroup::')
            return res
        print(f'::endgroup::')
        return None

jobs = [job for conf in listChangedConfigs() for job in jobsFor(conf)]

with ThreadPoolExecutor(max_workers=10) as executor:
    results = executor.map(runConf, jobs)

failed = [r for r in results if r is not None]

if failed:
    print('Some jobs failed:')
    for r in failed:
        print(f'\t{r.label}')
    sys.exit(1)
sys.exit(0)
